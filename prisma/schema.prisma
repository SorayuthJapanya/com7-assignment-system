generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique @db.VarChar(50)
  password     String        @db.VarChar(255)
  email        String        @db.VarChar(100)
  nickname     String        @db.VarChar(50)
  role         Role          @default(STAFF)
  isHidden     Boolean       @default(false)
  hiddenAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profileImage String?       @db.VarChar(500)
  resetAt      DateTime?
  assignments  Assignment[]
  scores       Score[]
  dailyReports DailyReport[]
  missionClaims MissionClaim[]
}

model Assignment {
  id                String   @id @default(uuid())
  userId            String
  title             String   @db.VarChar(100)
  description       String
  type              Type     @default(Individual)
  createdBy         String   @default("")
  assignTo          String   @default("")
  members           String[] @default([])
  reward            Int      @default(0)
  deadline          DateTime @default(now())
  submissionUrl     String   @default("")
  submitAt          DateTime @default(now())
  feedback          String   @default("")
  finalScore        Int      @default(0)
  earlyBirdModifier Float?                     
  adjustedScore     Int?                        
  status            Status   @default(Pending)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores            Score[]
}

model Score {
  id               String      @id @default(uuid())
  recipient_id     String
  assignment_id    String?
  reviewer         String      @default("")
  assignment_title String      @default("")
  score            Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  assignment       Assignment? @relation(fields: [assignment_id], references: [id])
  user             User        @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
}

model Level {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  emoji     String   @db.VarChar(10)
  minScore  Int
  maxScore  Int
  color     String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("levels")
}

model DailyReport {
  id          String       @id @default(uuid())
  userId      String
  date        DateTime     @db.Date
  description String
  imageUrl    String?      @db.VarChar(500)
  status      ReportStatus @default(Pending)
  reviewedBy  String?
  feedback    String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_reports")
}

model MissionClaim {
  id        String   @id @default(uuid())
  userId    String
  missionId String   // เช่น "speed-runner", "level-up", "quality-king"
  month     Int      // 1-12
  year      Int
  points    Int      // เก็บแต้มที่ได้ตอน claim ไว้เผื่อ audit ย้อนหลัง
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, month, year]) // กัน claim ซ้ำมิชชั่นเดียวกันในเดือนเดียวกัน
  @@map("mission_claims")
}

// schema.prisma
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?  // userId ของ SuperAdmin ที่กด reset (เก็บไว้ audit)
}


enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  INTERN
}

enum Type {
  Individual
  Group
}

enum Status {
  Pending
  Approved
  Rejected
}

enum ReportStatus {
  Pending
  Approved
  Rejected
}
