// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  username    String       @unique @db.VarChar(50)
  password    String       @db.VarChar(255)
  email       String       @db.VarChar(100)
  nickname    String       @db.VarChar(50)
  role         Role         @default(STAFF)
  profileImage String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignments Assignment[]
  scores      Score[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model Assignment {
  id            String   @id @default(uuid())
  userId        String
  title         String   @db.VarChar(100)
  description   String   @db.Text
  type          Type     @default(Individual)
  createdBy     String   @default("")
  assignTo      String   @default("")
  members       String[] @default([])
  reward        Int      @default(0)
  deadline      DateTime @default(now())
  submissionUrl String   @default("")
  submitAt      DateTime @default(now())
  feedback      String   @default("")
  finalScore    Int      @default(0)
  status        Status   @default(Pending)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores        Score[]
}

enum Type {
  Individual
  Group
}

enum Status {
  Pending
  Approved
  Rejected
}

model Score {
  id               String      @id @default(uuid())
  recipient_id     String
  assignment_id    String?
  reviewer         String      @default("")
  assignment_title String      @default("")
  score            Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  assignment       Assignment? @relation(fields: [assignment_id], references: [id], onDelete: SetNull)
}

model Level {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  emoji     String   @db.VarChar(10)
  minScore  Int
  maxScore  Int
  color     String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("levels")
}
